{
  "name": "propresenter-splash",
  "version": "0.1.3",
  "private": true,
  "description": "macOS splash app for choosing a ProPresenter workspace before opening ProPresenter.",
  "author": "ProPresenter Splash Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sambro09/propresenter-splash.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --mac --universal --dir",
    "dist": "npm run build && electron-builder --mac --universal",
    "release": "npm run build && electron-builder --mac --universal --publish always",
    "release:check-cert": "node scripts/validate-developer-id-certificate.mjs",
    "build:dmg-background": "node scripts/build-dmg-background.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.propresentersplash.app",
    "productName": "ProPresenter Splash",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Sambro09",
        "repo": "propresenter-splash",
        "releaseType": "release"
      }
    ],
    "artifactName": "ProPresenter-Splash-${version}-${arch}.${ext}",
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "13.0",
      "identity": "Developer ID Application",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "ProPresenter Splash uses Apple Events to close or focus ProPresenter during confirmed workspace switches.",
        "NSSupportsAutomaticGraphicsSwitching": true
      }
    },
    "dmg": {
      "background": "background.png",
      "iconSize": 128,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 176,
          "y": 176,
          "type": "file"
        },
        {
          "x": 486,
          "y": 176,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@swc/core": "^1.15.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "vite": {
      "esbuild": "^0.28.1"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@swc/core@1.15.41": true
  }
}
